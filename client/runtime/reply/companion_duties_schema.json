    "type": "object",
    "properties": {
      "schema_version": {
        "const": "companion-experience-appraisal/1"
      },
      "decision": {
        "type": "object",
        "properties": {
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,47}$"
                },
                "stance": {
                  "enum": [
                    "positive",
                    "negative"
                  ]
                },
                "user_quote": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "character_quote": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "experience_quote": {
                  "type": "string",
                  "maxLength": 240,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "episode_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200,
